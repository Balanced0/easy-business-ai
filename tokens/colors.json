  "semantic": {
    "$description": "Purpose-based tokens — use these in designs and layouts",

    "action": {
      "primary": { "$type": "color", "$value": "{primitive.commerce.700}" },
      "primary-hover": { "$type": "color", "$value": "{primitive.commerce.800}" },
      "primary-active": { "$type": "color", "$value": "{primitive.commerce.900}" },
      "secondary": { "$type": "color", "$value": "{primitive.mineral.200}" },
      "secondary-hover": { "$type": "color", "$value": "{primitive.mineral.300}" },
      "secondary-active": { "$type": "color", "$value": "{primitive.mineral.400}" },
      "destructive": { "$type": "color", "$value": "{primitive.rose.700}" },
      "destructive-hover": { "$type": "color", "$value": "{primitive.rose.800}" }
    },

    "feedback": {
      "success-bg": { "$type": "color", "$value": "{primitive.commerce.50}" },
      "success-text": { "$type": "color", "$value": "{primitive.commerce.800}" },
      "success-border": { "$type": "color", "$value": "{primitive.commerce.300}" },
      "success-icon": { "$type": "color", "$value": "{primitive.commerce.700}" },
      "warning-bg": { "$type": "color", "$value": "{primitive.turmeric.50}" },
