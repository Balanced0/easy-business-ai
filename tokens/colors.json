    "action": {
      "primary": { "$type": "color", "$value": "{primitive.commerce.300}" },
      "primary-hover": { "$type": "color", "$value": "{primitive.commerce.200}" },
      "secondary": { "$type": "color", "$value": "{primitive.market.700}" },
      "secondary-hover": { "$type": "color", "$value": "{primitive.market.600}" }
    }
